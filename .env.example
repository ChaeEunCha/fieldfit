# 로컬 개발용 환경변수 예시. 복사해서 .env.local로 저장 후 값 채우기.
# .env.local은 .gitignore에 의해 커밋되지 않음.

# 예선 단계는 mock 데이터만 사용하므로 비워둬도 됨 (본선에서 API 연동 시 채움)
KMA_API_KEY=
SOIL_INFO_API_KEY=
ANTHROPIC_API_KEY=

# Supabase (docs/DB.md 참고). URL과 anon key는 공개해도 되는 값이지만,
# service_role key는 절대 커밋하지 말고 서버 전용 환경(배포 시크릿 등)에만 둘 것.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
